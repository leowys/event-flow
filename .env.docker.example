# Usado por docker-compose.yml. Copiá este archivo a ".env" y completá AUTH_SECRET
# antes de correr "docker compose up". Si no lo hacés, se usa un valor por defecto
# (NO usar ese default en producción).

AUTH_SECRET=reemplazar-con-un-valor-random-largo
NEXT_PUBLIC_APP_URL=http://localhost:3001

# El puerto 3000 suele estar ocupado por otras apps de desarrollo,
# por eso el default acá es 3001. Cambialo si hace falta.
APP_PORT=3001

# Fallback opcional: podés configurar el proveedor de email directamente
# desde la app (Ajustes de email, dentro del dashboard) en vez de acá.
# Esto solo se usa si un organizador no configuró nada desde ahí. La misma
# configuración se usa para invitaciones, confirmaciones y verificación de cuenta.
RESEND_API_KEY=
EMAIL_FROM="Event Flow <no-reply@tu-dominio.com>"
