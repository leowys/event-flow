# Base de datos Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/eventflow"

# Secreto para firmar JWT de sesión (generar uno random de 32+ bytes)
AUTH_SECRET="reemplazar-con-un-valor-random-largo"

# Fallback opcional: si un organizador no configuró nada desde
# "Ajustes de email" dentro de la app, se usan estas variables (Resend).
# La misma configuración se usa para invitaciones, confirmaciones y
# verificación de cuenta.
# Para poder enviar emails, creá una cuenta gratis en https://resend.com,
# generá una API key, y verificá un dominio (o usá el dominio de pruebas
# de Resend mientras probás).
RESEND_API_KEY=
EMAIL_FROM="Event Flow <no-reply@tu-dominio.com>"

# Storage de imágenes (a definir en Etapa 0/4). Ejemplo con Cloudflare R2 / S3:
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# URL pública de la app (para armar links de RSVP, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
